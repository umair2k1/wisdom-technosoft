# Wisdom Technosoft - Environment Variables
#
# IMPORTANT:
# - Never commit actual secret keys or .env files to source control.
# - In production, configure these variables in the Cloudflare Pages Dashboard:
#   Project > Settings > Environment variables > Production / Preview.

# Public site canonical base URL (use your *.pages.dev address until custom domain is ready)
SITE_URL=https://wisdom-technosoft.pages.dev

# Destination email where contact form submissions will be routed
DESTINATION_EMAIL=wisdomtechnosoft04@gmail.com

# Official WhatsApp inquiry number (without plus sign or spaces: country code + 10 digits)
WHATSAPP_NUMBER=917447331127

# Form submission forwarder access key (e.g., Web3Forms free access key from https://web3forms.com)
# Required if forwarding form submissions via Cloudflare Pages Function
FORM_SERVICE_KEY=your_web3forms_or_email_service_key_here

# Pinned Node.js runtime version for reproducible Cloudflare Pages builds
NODE_VERSION=20.18.3
