{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "wisdom-technosoft",
  "main": "worker.js",
  "compatibility_date": "2026-10-24",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": "dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page"
  },
  "observability": {
    "enabled": true
  }
}
