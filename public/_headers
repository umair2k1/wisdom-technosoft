# Cloudflare Pages Headers Configuration
# Documentation: https://developers.cloudflare.com/pages/configuration/headers/

# Global security headers for all routes
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: https:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto: tel:;
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# Immutable long-lived cache for static media and hashed assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Cache CSS & JS with revalidation
/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Always revalidate HTML documents to ensure visitors receive the latest updates immediately
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate
