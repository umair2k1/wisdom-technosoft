---
import { vision, mission } from '../data/content.js';
---

<section id="vision" class="vision" data-vision data-hud-label="Vision">
  <div class="pin">
    <div class="vision-in">
      <h2 class="kicker">Our vision</h2>
      <p class="vision-text" data-vision-text>{vision}</p>

      <div class="mission" data-mission>
        <h2 class="kicker">Our mission</h2>
        <p>{mission}</p>
      </div>
    </div>
  </div>
</section>
