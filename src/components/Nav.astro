---
import Logo from './Logo.astro';
import { site } from '../data/site.js';

const isHome = Astro.url.pathname === '/' || Astro.url.pathname === '';
const to = (hash: string) => (isHome ? hash : `/${hash}`);

const links = [
  { href: to('#software'), label: 'What we do' },
  { href: to('#approach'), label: 'How we work' },
  { href: to('#vision'), label: 'Vision' },
  { href: to('#team'), label: 'Team' },
  { href: to('#contact'), label: 'Contact' },
];
---

<header class="nav" data-nav>
  <a href="/" class="brand" aria-label="Wisdom Technosoft — home">
    <Logo class="brand-mark" />
    <span class="brand-name">Wisdom Technosoft</span>
  </a>

  <div class="nav-right">
    <a href={to('#contact')} class="nav-cta">Start a project</a>
    <button type="button" class="menu-btn" data-menu-toggle aria-expanded="false" aria-controls="menu">
      <span class="menu-label">Menu</span>
      <span class="menu-bars" aria-hidden="true"><i></i><i></i></span>
    </button>
  </div>
</header>

<div id="menu" class="menu" data-menu aria-hidden="true" inert>
  <nav aria-label="Primary">
    <ul class="menu-list">
      {
        links.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>
  <div class="menu-foot">
    <a href={`mailto:${site.email}`}>{site.email}</a>
    <a href={site.phoneHref}>{site.phone}</a>
    <span>Nagpur, Maharashtra, India</span>
  </div>
</div>

<script>
  const html = document.documentElement;
  const header = document.querySelector('[data-nav]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const menu = document.querySelector('[data-menu]');

  if (header && toggle && menu) {
    const label = toggle.querySelector('.menu-label');
    const behind = Array.from(document.querySelectorAll('main, footer, .hud-count, .hud-rail'));

    const setOpen = (open) => {
      const wasOpen = html.classList.contains('menu-open');
      html.classList.toggle('menu-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      menu.setAttribute('aria-hidden', String(!open));
      menu.inert = !open;
      behind.forEach((el) => (el.inert = open));
      if (label) label.textContent = open ? 'Close' : 'Menu';
      if (open) {
        header.classList.remove('is-hidden');
        const first = menu.querySelector('a');
        if (first) window.requestAnimationFrame(() => first.focus({ preventScroll: true }));
      } else if (wasOpen) {
        toggle.focus({ preventScroll: true });
      }
    };

    setOpen(false);
    toggle.addEventListener('click', () => setOpen(!html.classList.contains('menu-open')));
    menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && html.classList.contains('menu-open')) setOpen(false);
    });

    /* Tuck the bar away while scrolling down, bring it back on the way up. */
    let last = window.scrollY;
    let ticking = false;
    window.addEventListener(
      'scroll',
      () => {
        if (ticking) return;
        ticking = true;
        window.requestAnimationFrame(() => {
          const y = window.scrollY;
          const open = html.classList.contains('menu-open');
          if (y > 240 && y > last + 4 && !open) header.classList.add('is-hidden');
          else if (y < last - 4) header.classList.remove('is-hidden');
          last = y;
          ticking = false;
        });
      },
      { passive: true },
    );
  }
</script>
