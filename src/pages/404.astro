---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
---

<Layout title="Page not found — Wisdom Technosoft" description="This page does not exist." noindex>
  <Nav />

  <main id="main-content" class="doc doc-center">
    <p class="kicker">404</p>
    <h1>This page isn’t here.</h1>
    <p class="lead">The link may be old or the address mistyped. The homepage is a good place to start again.</p>
    <p class="doc-actions"><a href="/" class="btn">Back to the homepage</a></p>
  </main>

  <Footer />
</Layout>
